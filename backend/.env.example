# ============================================================
# MRV BookHub Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
DATABASE_PATH=./database/mrv_bookhub.db

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
# BCrypt work factor (10-14)
BCRYPT_SALT_ROUNDS=12

# --- Frontend CORS ---
# Comma separated list of allowed origins
FRONTEND_URL=http://localhost:5173

# --- File uploads ---
UPLOAD_DIR=./uploads/book-images
MAX_IMAGE_SIZE_BYTES=2048000

# --- Email (SMTP) - leave blank to run in dev console mode ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MRV BookHub <no-reply@mrvbookhub.local>"

# --- OTP / Password reset ---
OTP_EXPIRY_MINUTES=10
OTP_RESEND_LIMIT=3
OTP_RESEND_WINDOW_MINUTES=15
# Development only: when true AND SMTP is not configured, the OTP is
# returned in the API response for local testing.
# MUST be false in production.
DEV_SIMULATE_OTP=true

# --- SMS provider (optional, real delivery requires a provider account) ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Library policy ---
RESERVATION_EXPIRY_DAYS=3
DEFAULT_MAX_ISSUE_DAYS=14

# --- Reminder schedule (node-cron) ---
REMINDER_CRON=0 9 * * *
REMINDER_UPCOMING_DAYS=2
REMINDER_ENABLED=true
